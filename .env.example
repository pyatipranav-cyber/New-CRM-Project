# Copy to .env for local development. On Vercel, set these in
# Project Settings > Environment Variables (never commit real values).

# PostgreSQL connection string. On Vercel + Neon this is added automatically.
# Use the POOLED connection string (host contains "-pooler") in production.
DATABASE_URL=postgres://user:password@localhost:5432/followup

# Secret used to sign login sessions. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional
# SESSION_DAYS=30          # how long a login lasts (default 30)
# LOG_LEVEL=info           # debug | info | warn | error
# AUTO_MIGRATE=true        # set to false to run migrations only via `npm run migrate`
# PG_POOL_MAX=5            # connections per server instance
# DB_SSL_NO_VERIFY=false   # true only if your provider uses a private CA (some Supabase poolers)
